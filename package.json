{
  "name": "tiki-place",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm data:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync": "tsx sync/cli.ts",
    "review": "tsx sync/cli.ts review",
    "source": "tsx sync/cli.ts source",
    "validate": "tsx sync/cli.ts validate",
    "data:build": "tsx sync/cli.ts data:build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "mapbox-gl": "3.33.0",
    "minisearch": "7.2.0",
    "next": "16.4.3",
    "nuqs": "2.10.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
